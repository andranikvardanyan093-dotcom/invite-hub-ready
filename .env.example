# Required for production
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:5173

# White-label edge (optional docs for custom domains — SSL is infra-owned)
# VITE_EDGE_CNAME_TARGET=edges.invitehub.am

# Local-only: allow in-memory demo when Supabase env is missing (never in production)
# VITE_ALLOW_DEMO=true

# Observability
# VITE_APP_ENV=production
# VITE_APP_VERSION=1.0.0
# VITE_LOG_LEVEL=info
# VITE_SENTRY_DSN=
# VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# AI module — default curated (offline) provider; set openai + edge URL for production LLM
# VITE_AI_PROVIDER=curated
# VITE_AI_PROVIDER=openai
# VITE_AI_EDGE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/ai
# VITE_OPENAI_MODEL=gpt-4o-mini
# Dev-only client key (never enable in production):
# VITE_AI_ALLOW_CLIENT_KEY=true
# VITE_OPENAI_API_KEY=
# VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Edge Function secrets (set in Supabase Dashboard, not Vite):
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
# ALLOWED_ORIGIN=https://your-domain.com
# BACKUP_WEBHOOK_URL=
# IMAGE_TRANSFORM_URL=
